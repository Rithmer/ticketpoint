<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.ticketpoint.fx.PasswordDialogController" spacing="10"
      prefWidth="400" styleClass="form">
    <Label text="Текущий пароль"/>
    <PasswordField fx:id="currentPassword"/>
    <Label text="Новый пароль"/>
    <PasswordField fx:id="newPassword"/>
    <Label text="От 12 до 128 символов" styleClass="muted"/>
    <Label text="Повторите новый пароль"/>
    <PasswordField fx:id="confirmation"/>
    <Label fx:id="feedback" styleClass="error" wrapText="true"/>
</VBox>
