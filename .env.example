POSTGRES_DB=ticketpoint
POSTGRES_USER=ticketpoint
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
BACKEND_PORT=8080

DB_URL=jdbc:postgresql://localhost:5433/ticketpoint
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}

APP_ZONE=Europe/Moscow
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_SECONDS=15
DB_SOCKET_TIMEOUT_SECONDS=30

BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=
COOKIE_SECURE=false

# Generate once: openssl rand -base64 32
JWT_SECRET_BASE64=
JWT_ISSUER=ticketpoint
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
CORS_ALLOWED_ORIGINS=http://localhost:8080
